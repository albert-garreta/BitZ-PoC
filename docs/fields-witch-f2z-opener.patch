@@ -5,6 +5,13 @@ edition = "2024"
 
 [features]
 hash-count = []
+# Local benchmark instantiation, not part of upstream fields-witch: commit and
+# open the two dense F_{2^128} phases (P_0 and the concatenated tails) with the
