+    /// The callback sees zero-filled omitted entries and any even-length padding.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn fold_prefix_table_with<const K: usize, T: Send>(
+        &self,
+        num_vars: usize,
+        live_len: usize,
+        challenges: &[Field],
