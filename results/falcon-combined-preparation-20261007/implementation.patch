+fn centered_s1(target: &[u16; N], product: &[i64]) -> [i16; N] {
+    std::array::from_fn(|j| {
+        let residue = (i64::from(target[j]) - product[j] + product[N + j]).rem_euclid(Q);
+        (if residue > Q / 2 {
+            residue - Q
+        } else {
+            residue
+        }) as i16
+    })
