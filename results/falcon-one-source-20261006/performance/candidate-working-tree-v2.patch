+    fn const_pin_value(&self, outer_point: &[Gf128]) -> Gf128 {
+        let signature_vars = self.capacity.ilog2() as usize;
+        assert!(outer_point.len() >= signature_vars);
+        prefix_mask(&outer_point[..signature_vars], self.batch_len)
+    }
