+/// Borrow the field words' native-endian representation without padding.
+/// On little-endian hosts this is the canonical `lo || hi` commitment encoding.
+pub fn codeword_bytes(codeword: &[Gf128]) -> &[u8] {
+    // SAFETY: Gf128 is repr(C, align(16)) with two adjacent u64s and no
+    // padding. Every byte is initialized and the borrow retains its lifetime.
+    unsafe {
+        core::slice::from_raw_parts(
+            codeword.as_ptr().cast::<u8>(),
+            core::mem::size_of_val(codeword),
+        )
+    }
+}
