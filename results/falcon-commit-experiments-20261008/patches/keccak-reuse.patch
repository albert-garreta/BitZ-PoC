 use std::sync::Mutex;
 
 static POOL: Mutex<Vec<Vec<Gf128>>> = Mutex::new(Vec::new());
+static BYTE_POOL: Mutex<Vec<Vec<u8>>> = Mutex::new(Vec::new());
+
+// Falcon needs at most three Keccak slabs. Keep one allocation of each
+// capacity, bounded across concurrent proofs and changes in batch size.
+const MAX_BYTE_BUFFERS: usize = 3;
+
+/// Take a zeroed byte buffer for a Keccak lincheck stripe. Unlike `take_f128`,
+/// this clears recycled contents because the emitter leaves padding untouched.
+pub fn take_bytes_zeroed(n: usize) -> Vec<u8> {
+    take_bytes_zeroed_from(&BYTE_POOL, n)
+}
+
+fn take_bytes_zeroed_from(pool: &Mutex<Vec<Vec<u8>>>, n: usize) -> Vec<u8> {
+    let mut pool = pool.lock().unwrap();
+    let best = pool
+        .iter()
+        .enumerate()
+        .filter(|(_, bytes)| bytes.capacity() >= n)
+        .min_by_key(|(_, bytes)| bytes.capacity())
+        .map(|(i, _)| i);
+    let recycled = best.map(|i| pool.swap_remove(i));
+    drop(pool);
+    match recycled {
+        Some(mut bytes) => {
+            use rayon::prelude::*;
+            let reused = bytes.len().min(n);
+            bytes.resize(n, 0);
+            bytes[..reused]
+                .par_chunks_mut(1 << 16)
+                .for_each(|chunk| chunk.fill(0));
+            bytes
+        }
+        None => vec![0; n],
+    }
+}
+
+/// Return a byte buffer, retaining at most one allocation of each capacity
+/// and at most three capacities. Larger allocations win when the pool is full.
+pub fn give_bytes(bytes: Vec<u8>) {
+    give_bytes_to(&BYTE_POOL, bytes);
+}
+
+fn give_bytes_to(pool: &Mutex<Vec<Vec<u8>>>, bytes: Vec<u8>) {
+    if bytes.capacity() == 0 {
+        return;
+    }
+    let mut pool = pool.lock().unwrap();
+    if pool.iter().any(|v| v.capacity() == bytes.capacity()) {
+        return;
+    }
+    pool.push(bytes);
+    if pool.len() > MAX_BYTE_BUFFERS {
+        let smallest = pool
+            .iter()
+            .enumerate()
+            .min_by_key(|(_, bytes)| bytes.capacity())
+            .map(|(i, _)| i)
+            .expect("pool non-empty");
+        pool.swap_remove(smallest);
+    }
+}
 
