+
+impl<const K: usize> PreparedPublicDotProducts<K> {
+    pub fn new(weights: &[Q12289Extension<K>]) -> Self {
+        assert!(matches!(K, 9 | 10 | 11), "unsupported extension degree");
+        assert!(
+            weights.iter().all(|value| value.canonical()),
