+#[cfg(feature = "parallel")]
+#[test]
+#[ignore = "manual first-fold kernel comparison; run without other benchmarks"]
+fn benchmark_first_word_fold_variants() {
+    use std::{hint::black_box, time::Instant};
+    let mut modulus = (1u128 << 126) - 1;
+    while !field::is_probable_prime_public(&Uint::<2>::from(modulus)) {
+        modulus -= 2;
+    }
+    let f = F::make_cfg(&Uint::from(modulus)).unwrap();
+    let layout = Layout::new(1024).unwrap();
+    let source = source_fixture(&layout);
+    let form = form_fixture(&layout, &f);
+    let r = F::from_with_cfg(modulus / 3, &f);
+    for workers in [1, 8, 12, 16] {
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap();
+        pool.install(|| {
+            let expected = first_fold_with::<0, false>(&form, &source, r, &f);
+            for trial in 0..12 {
+                for offset in 0..4 {
+                    let mode = (trial + offset) % 4;
+                    let start = Instant::now();
+                    let actual = match mode {
+                        0 => first_fold_with::<0, false>(black_box(&form), &source, black_box(r), &f),
+                        1 => first_fold_with::<1, false>(black_box(&form), &source, black_box(r), &f),
+                        2 => first_fold_with::<1, true>(black_box(&form), &source, black_box(r), &f),
+                        _ => first_fold_with::<2, false>(black_box(&form), &source, black_box(r), &f),
+                    };
+                    black_box(&actual);
+                    let ms = start.elapsed().as_secs_f64() * 1000.0;
+                    assert_eq!(actual, expected);
+                    println!("{{\"degree\":{N},\"batch\":1024,\"workers\":{workers},\"trial\":{trial},\"mode\":{mode},\"ms\":{ms}}}");
+                }
+            }
+        });
+    }
+}
