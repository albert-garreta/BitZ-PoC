+                    let a = decode(word(source, i));
+                    let b = decode(word(source, i + 1));
+                    signed_acc(&mut sums[0], &w0, a, f);
+                    signed_acc(&mut sums[1], &f.sub(&w1, &w0), b - a, f);
+                    if !reuse_product {
