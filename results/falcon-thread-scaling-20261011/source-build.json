    "balanced_guard_source": "\"\"\"Validate pair order and pre-existing inputs before invoking the unchanged runner.\"\"\"\nimport collections\nfrom pathlib import Path\nimport sys\nsys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'scripts'))\nimport binder_experiments as runner\noriginal = runner.build_manifest\ndef checked(args):\n    manifest = original(args)\n    counts = collections.defaultdict(collections.Counter)\n    jobs = manifest['jobs']\n    for a, b in zip(jobs[::2], jobs[1::2]):\n        assert (a['variant'], a['threads'], a['seed'], a['repetition']) == (b['variant'], b['threads'], b['seed'], b['repetition'])\n        assert {a['config']['name'], b['config']['name']} == {'baseline', 'candidate'}\n        counts[a['variant'], a['threads']][a['config']['name']] += 1\n    for cell, count in counts.items():\n        assert count['baseline'] == count['candidate'], (cell, count)\n    for seed in args.seeds:\n        case = args.case_cache / f'fn-dsa-0.3.0-n{args.degree}-b{args.batch}-seed{seed}.bin'\n        assert case.is_file(), case\n    print('Balanced order and pre-existing cases verified:', dict(counts), flush=True)\n    return manifest\nrunner.build_manifest = checked\nrunner.main()\n",
