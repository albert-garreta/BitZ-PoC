+    #[test]
+    fn single_algebraic_source_bridge_authenticates_without_falcon_trace() {
+        let p = IntegerMatrixLayout {
+            row_vars: 13,
+            col_vars: 3,
+        };
+        let field = crate::prime_sampling::sample_prime_context(
+            &mut Blake3Transcript::new(),
+            1u128 << 125,
+            (1u128 << 126) - 1,
+            128,
+        )
+        .unwrap();
+        let modulus = field.modulus_u128();
+        let point: Vec<_> = (0..p.row_vars + p.col_vars)
+            .map(|i| F::from_with_cfg(Uint::from(3 + 2 * i as u128), &field))
+            .collect();
+        let row_weights = weights(&point[..p.row_vars], &field);
+        let column_weights = weights(&point[p.row_vars..], &field);
+        let rows: Vec<Vec<u64>> = (0..p.cols())
+            .map(|column| {
+                (0..p.rows() / 64)
+                    .map(|word| 0x8102_0408_1020_4081u64.rotate_left(((word + column) % 64) as u32))
+                    .collect()
+            })
+            .collect();
+        let mut prime_value = 0;
+        for (column, bits) in rows.iter().enumerate() {
+            for row in 0..p.rows() {
+                if (bits[row / 64] >> (row % 64)) & 1 == 1 {
+                    prime_value = field.add_u128(
+                        prime_value,
+                        field.mul_u128(row_weights[row], column_weights[column]),
+                    );
+                }
+            }
+        }
+        let value = F::from_with_cfg(Uint::from(prime_value), &field);
+        let mut pt = Blake3Transcript::new();
+        let (proof, claim) = super::prove(
+            &mut pt,
+            &p,
+            &rows,
+            BridgeMode::TwoLimbs,
+            &point,
+            modulus,
+            0,
+            &row_weights,
+        )
+        .unwrap();
+        let mut vt = Blake3Transcript::new();
+        let verified = super::verify(
+            &mut vt,
+            &p,
+            BridgeMode::TwoLimbs,
+            &point,
+            value,
+            modulus,
+            &proof,
+            0,
+        )
+        .unwrap();
+        assert_eq!(claim.low, verified.low);
+        assert_eq!(claim.high_point, verified.high_point);
+        assert_eq!(claim.value, verified.value);
+        assert_eq!(pt.get_challenge::<u128>(), vt.get_challenge::<u128>());
+        let column_eq = build_eq_x_r_vec(&claim.high_point, &()).unwrap();
+        let mut binary_value = Gf::zero();
+        for (column, bits) in rows.iter().enumerate() {
+            for row in 0..p.rows() {
+                if (bits[row / 64] >> (row % 64)) & 1 == 1 {
+                    binary_value += column_eq[column] * claim.low[row];
+                }
+            }
+        }
+        assert_eq!(claim.value, binary_value);
+        let wrong_value = F::from_with_cfg(Uint::from(field.add_u128(prime_value, 1)), &field);
+        assert!(
+            super::verify(
+                &mut Blake3Transcript::new(),
+                &p,
+                BridgeMode::TwoLimbs,
+                &point,
+                wrong_value,
+                modulus,
+                &proof,
+                0
+            )
+            .is_err()
+        );
+        assert!(
+            super::prove(
+                &mut Blake3Transcript::new(),
+                &p,
+                &rows[..rows.len() - 1],
+                BridgeMode::TwoLimbs,
+                &point,
+                modulus,
+                0,
+                &row_weights
+            )
+            .is_err()
+        );
+        let mut bad_rows = rows;
+        bad_rows[0].pop();
+        assert!(
+            super::prove(
+                &mut Blake3Transcript::new(),
+                &p,
+                &bad_rows,
+                BridgeMode::TwoLimbs,
+                &point,
+                modulus,
+                0,
+                &row_weights
+            )
+            .is_err()
+        );
+    }
