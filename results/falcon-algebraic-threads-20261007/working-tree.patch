-    t: &mut impl Transcript,
-    geometry: &Geometry<N>,
-    target: F,
-    grinding_bits: u32,
-) {
-    t.absorb_slice(b"bitz/falcon/joint-binary-sumcheck/v1");
-    for log in geometry.logs {
-        t.absorb_slice(&(log as u64).to_le_bytes());
-    }
-    t.absorb_slice(&grinding_bits.to_le_bytes());
-    observe(t, &[target]);
-}
