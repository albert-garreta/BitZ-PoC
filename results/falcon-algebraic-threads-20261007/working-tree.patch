-    let hi = integer_polynomial_product(&a[h..], &b[h..]);
-    let asum: Vec<_> = (0..h).map(|i| a[i] + a[h + i]).collect();
-    let bsum: Vec<_> = (0..h).map(|i| b[i] + b[h + i]).collect();
