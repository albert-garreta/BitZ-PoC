+    fn prefix_equality_matches_dense_for_every_limit() {
+        let mut random = Random(0x7072_6566_6978);
+        for vars in 0..=6 {
+            let a: Vec<_> = (0..vars).map(|_| random.next()).collect();
+            for kind in 0..3 {
+                let b: Vec<_> = (0..vars)
+                    .map(|i| match kind {
+                        0 => F::ZERO,
+                        1 if i % 2 == 0 => F::ONE,
+                        _ => random.next(),
+                    })
+                    .collect();
