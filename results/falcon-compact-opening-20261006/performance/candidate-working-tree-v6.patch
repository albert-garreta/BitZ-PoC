+    #[ignore = "timing benchmark; run alone on an idle machine"]
+    fn lane_contiguous_walker_abba_microbenchmark() {
+        use std::{hint::black_box, time::Instant};
+        let mut rng = Rng::new(0x1A4E_ABBA_2026);
+        let weights: Vec<_> = (0..K)
