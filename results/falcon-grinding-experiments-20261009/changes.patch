+            let codeword = &rate * &columns;
+            let delta_n = (&rate - 1u8) * &columns;
+            let denominator = 2u8 * &rate * &delta_n;
+            let gamma_numerator = (&rate - 1u8) * &delta_n - 6u8 * &rate;
+            let folds = if level_index == 0 { config.initial_k } else { level.k_recursive };
+            for round in 0..folds {
+                let block = blocks.next().unwrap();
+                assert_eq!(block.label, format!("fold/{level_index}/{round}"));
+                assert!(block.bits >= block.native_bits.unwrap_or(0));
+                // UDR pg = (gamma*n + 1)/2^128, plus two fold algebraic errors.
+                let numerator = &gamma_numerator * &codeword + 3u8 * &denominator;
+                error += rational_dyadic_ceil(numerator, &denominator, scale - 128 - block.bits as usize);
+            }
+            let block = blocks.next().unwrap();
+            assert_eq!(block.label, format!("queries/{level_index}"));
+            assert!(block.bits >= block.native_bits.unwrap_or(0));
+            let query_numerator = (&denominator - &gamma_numerator).pow(level.queries as u32);
+            let query_denominator = denominator.pow(level.queries as u32);
+            error += rational_dyadic_ceil(query_numerator, &query_denominator, scale - block.bits as usize);
+            let alpha_vars = level.queries.next_power_of_two().ilog2() as usize;
+            let suffix = usize::from(level_index + 1 == config.levels.len());
+            error += BigUint::from(alpha_vars + suffix) << (scale - 128 - block.bits as usize);
+            if level_index + 1 < config.levels.len() {
+                let block = blocks.next().unwrap();
+                assert_eq!(block.label, format!("introduce/{level_index}"));
+                error += BigUint::from(1u8) << (scale - 128 - block.bits as usize);
+            }
+        }
+        assert!(blocks.next().is_none());
+        error
+    }
+
