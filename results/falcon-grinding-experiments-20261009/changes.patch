+//! Temporary experiment controls, confined to the archived experiment checkout.
+//! Every derived difficulty/configuration is bound by Falcon's existing digest;
+//! environment variables are consulted only while preparing that configuration.
+use super::grinding_allocation::{self, GrindingGroup, MAX_BITS};
+use std::ops::Range;
+
+fn flag(name: &str) -> bool {
+    match std::env::var(name) {
+        Err(std::env::VarError::NotPresent) => false,
+        Ok(value) if value == "0" => false,
+        Ok(value) if value == "1" => true,
+        _ => panic!("invalid experimental boolean {name}"),
+    }
+}
+pub(crate) fn global() -> bool { flag("BITZ_EXPERIMENT_GLOBAL") }
+pub(crate) fn corrected_sites() -> bool { flag("BITZ_EXPERIMENT_CORRECTED_SITES") }
+
+pub(crate) fn allocate(groups: &[GrindingGroup], budget: f64, pcs: Range<usize>) -> Result<Vec<u32>, String> {
+    let baseline = grinding_allocation::allocate(groups, budget)?;
+    let Some(path) = std::env::var_os("BITZ_EXPERIMENT_COST_FILE") else { return Ok(baseline) };
+    let threads = std::env::var("BITZ_EXPERIMENT_COST_THREADS").map_err(|_| "missing cost-model thread class")?;
+    let input = std::fs::read(path).map_err(|e| e.to_string())?;
+    let data: serde_json::Value = serde_json::from_slice(&input).map_err(|e| e.to_string())?;
+    let read_curve = |name: &str| -> Result<Vec<f64>, String> {
+        let values = data["curves_unconstrained"][&threads][name].as_array().ok_or("missing cost curve")?;
+        if values.len() != 33 { return Err("cost curve must contain difficulties 0..32".into()) }
+        let result: Vec<f64> = values.iter().map(|v| v.as_f64().unwrap_or(f64::NAN)).collect();
+        if result.iter().any(|v| !v.is_finite() || *v < 0.) {
+            return Err("cost curve must be finite and nonnegative".into())
+        }
+        Ok(result)
+    };
+    let spartan = read_curve("spartan")?;
+    let lig = read_curve("pcs")?;
+    let costs: Vec<Vec<f64>> = groups.iter().enumerate().map(|(i,g)| {
+        let curve = if pcs.contains(&i) { &lig } else { &spartan };
+        curve.iter().map(|c| c * g.sites).collect()
+    }).collect();
+    allocate_costed(groups, budget, &costs, baseline)
+}
+
+fn allocate_costed(groups: &[GrindingGroup], budget: f64, costs: &[Vec<f64>], fallback: Vec<u32>) -> Result<Vec<u32>, String> {
+    let error = |bits: &[u32]| groups.iter().zip(bits).map(|(g,b)| g.raw_error * 2f64.powi(-(*b as i32))).sum::<f64>();
+    let work = |bits: &[u32]| costs.iter().zip(bits).map(|(c,b)| c[*b as usize]).sum::<f64>();
+    // A harder search can be faster when it switches to the parallel kernel.
+    // Remove dominated difficulties before marginal allocation; every remaining
+    // step strictly increases modeled time while decreasing its error.
+    let choices: Vec<Vec<u32>> = groups.iter().enumerate().map(|(i,g)| {
+        (g.min_bits..=MAX_BITS).filter(|&b| ((b+1)..=MAX_BITS).all(|harder| costs[i][harder as usize] > costs[i][b as usize])).collect()
+    }).collect();
+    let mut bits: Vec<u32> = choices.iter().map(|c|c[0]).collect();
+    while error(&bits) > budget {
+        let mut best = None;
+        for (i,g) in groups.iter().enumerate() {
+            let b = bits[i];
+            let Some(&next) = choices[i].iter().find(|&&x|x>b) else {continue};
+            if g.raw_error == 0. {continue}
+            let ratio = g.raw_error * (2f64.powi(-(b as i32))-2f64.powi(-(next as i32))) / (costs[i][next as usize]-costs[i][b as usize]);
+            if best.is_none_or(|(_,_,score)|ratio>score) {best=Some((i,next,ratio))}
+        }
+        let (i,next,_) = best.ok_or("unreachable costed grinding budget")?;
+        bits[i]=next;
+    }
+    let mut order:Vec<usize>=(0..groups.len()).collect();
+    order.sort_by(|&i,&j|costs[j][bits[j] as usize].total_cmp(&costs[i][bits[i] as usize]).then(i.cmp(&j)));
+    for i in order {
+        while let Some(&previous) = choices[i].iter().rev().find(|&&x|x<bits[i]) {
+            let saved=bits[i];bits[i]=previous;
+            if error(&bits)>budget {bits[i]=saved;break}
+        }
+    }
+    let fallback: Vec<u32> = fallback.iter().enumerate().map(|(i,&b)| *choices[i].iter().find(|&&x|x>=b).unwrap()).collect();
+    if work(&fallback) < work(&bits) {bits=fallback}
+    // Exchange a few bits between groups to cross dispatch-cost discontinuities.
+    loop {
+        let e=error(&bits);let w=work(&bits);let mut best=None;
+        for i in 0..groups.len() {
+            for down in 1..=3.min(bits[i]-groups[i].min_bits) {
+                for j in 0..groups.len() {
+                    if i==j {continue}
+                    for up in 1..=3.min(MAX_BITS-bits[j]) {
+                        let next_e=e+groups[i].raw_error*2f64.powi(-(bits[i] as i32))*(2f64.powi(down as i32)-1.)
+                            +groups[j].raw_error*2f64.powi(-(bits[j] as i32))*(2f64.powi(-(up as i32))-1.);
+                        let next_w=w+costs[i][(bits[i]-down) as usize]-costs[i][bits[i] as usize]
+                            +costs[j][(bits[j]+up) as usize]-costs[j][bits[j] as usize];
+                        if next_e<=budget && next_w<w-1e-9 && best.is_none_or(|(bw,_,_,_,_)|next_w<bw) {
+                            // Check the canonical summation too, avoiding acceptance due to cancellation.
+                            let mut candidate=bits.clone();candidate[i]-=down;candidate[j]+=up;
+                            if error(&candidate)<=budget && work(&candidate)<w-1e-9 { best=Some((work(&candidate),i,j,down,up)); }
+                        }
+                    }
+                }
+            }
+        }
+        let Some((_,i,j,down,up))=best else {break};bits[i]-=down;bits[j]+=up;
+    }
+    if error(&bits)>budget {return Err("costed allocation misses composed budget".into())}
+    Ok(bits)
+}
