+const EXPERIMENTAL_QUERY_PREFIX: &str =
+    "udr_maximal_radius_with_fold_grinding/experimental-raw-query-bits=";
+
+fn experimental_query_bits(request: Option<&str>) -> Result<Option<usize>, String> {
+    match request {
+        None | Some("off" | "128") => Ok(None),
+        Some("124") => Ok(Some(124)),
+        Some("120") => Ok(Some(120)),
+        Some("116") => Ok(Some(116)),
+        _ => Err("BITZ_EXPERIMENT_QUERY_BITS must be off, 128, 124, 120 or 116".into()),
+    }
+}
+
+fn apply_experimental_queries(
+    security: &mut LigeritoSecurityConfig,
+    query_bits: usize,
+) -> Result<(), String> {
+    for level in &mut security.levels {
+        if level.regime != SoundnessRegime::Udr || level.target_security_bits != 128 {
+            return Err("experimental query schedule requires 128-bit UDR levels".into());
+        }
+        // Keep the native 128-bit target. Query-phase grinding supplies only
+        // the query shortfall; it never receives credit for fold soundness.
+        level.queries = (1..=100_000)
+            .find(|&queries| {
+                level.queries = queries;
+                level.paper_predicted_bits().1 + 1e-3 >= query_bits as f64
+            })
+            .ok_or("experimental UDR query search did not converge")?;
+        let (fold_bits, raw_query_bits) = level.paper_predicted_bits();
+        if !fold_bits.is_finite() || !raw_query_bits.is_finite() {
+            return Err("non-finite experimental UDR soundness".into());
+        }
+        level.grinding_bits = (128.0 - raw_query_bits).ceil().max(0.0) as usize;
+        level.expected_eps_pg_bits = fold_bits;
+        level.expected_eps_query_bits = raw_query_bits;
+    }
+    security.analysis_version = format!("{EXPERIMENTAL_QUERY_PREFIX}{query_bits}");
+    security.validate()
 }
 
