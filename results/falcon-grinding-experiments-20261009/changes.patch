+    fn costed_allocation_trades_work_without_weakening_error_budget() {
+        let groups=[GrindingGroup{raw_error:1.,sites:1.,min_bits:0},GrindingGroup{raw_error:1.,sites:1.,min_bits:0}];
+        let fallback=grinding_allocation::allocate(&groups,0.625).unwrap();
+        let costs=vec![(0..33).map(|b|10.*2f64.powi(b)).collect(),(0..33).map(|b|2f64.powi(b)).collect()];
+        let chosen=allocate_costed(&groups,0.625,&costs,fallback.clone()).unwrap();
+        let e=groups.iter().zip(&chosen).map(|(g,b)|g.raw_error*2f64.powi(-(*b as i32))).sum::<f64>();
+        let work=|b:&[u32]|costs.iter().zip(b).map(|(c,b)|c[*b as usize]).sum::<f64>();
+        assert!(e<=0.625);assert!(work(&chosen)<work(&fallback));assert_eq!(chosen,vec![1,3]);
+    }
