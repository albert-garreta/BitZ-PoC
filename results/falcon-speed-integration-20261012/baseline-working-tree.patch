+                (0..p.rows() / 64)
+                    .map(|word| match column {
+                        0 => u64::MAX,
+                        1 => 0,
+                        2 => 0xaaaa_aaaa_aaaa_aaaa,
+                        _ => 1u64 << ((13 * word + column) % 64),
+                    })
+                    .collect()
+            })
