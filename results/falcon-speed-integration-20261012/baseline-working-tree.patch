+    fn binary_claim_value(rows: &[Vec<u64>], claim: &BinaryClaim) -> Gf {
+        let cols = build_eq_x_r_vec(&claim.high_point, &()).unwrap();
+        rows.iter()
+            .zip(cols)
+            .fold(Gf::zero(), |acc, (bits, column)| {
+                let sum = claim
+                    .low
+                    .iter()
+                    .enumerate()
+                    .fold(Gf::zero(), |sum, (row, &weight)| {
+                        if bits[row / 64] >> (row % 64) & 1 == 1 {
+                            sum + weight
+                        } else {
+                            sum
+                        }
+                    });
+                acc + sum * column
+            })
+    }
