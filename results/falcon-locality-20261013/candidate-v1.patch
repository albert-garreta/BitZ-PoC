+pub(super) fn fallback_grain(rows: usize, matrix_bytes: usize) -> usize {
+    let requested = requested_grain();
+    if requested == 1 {
+        return 1;
+    }
+    bounded_grain(requested, rows, matrix_bytes, rayon::current_num_threads())
