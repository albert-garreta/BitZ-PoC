+        initialize_dense_chunks::<512>(output, live / 2, f, true, false, slot)
+    } else {
+        output.clear();
+        output.extend((0..live / 2).map(slot));
+        dense_sums(output, 1, f)
+    };
+    std::mem::swap(values, output);
+    *stride = 1;
+    sums
