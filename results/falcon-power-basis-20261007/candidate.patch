+            if (K == 9 && i == 3) || (K == 10 && (i == 2 || i == 5)) || (K == 11 && i == 1) {
+                let mut a = modulus.clone();
+                let mut b = power.sub(theta).0.map(Word::from).to_vec();
+                trim(&mut b);
