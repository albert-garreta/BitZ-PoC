\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Proving one MultiSwap \cite  {multiswap} batch update: two RSA-2048 accumulator updates verified through Wesolowski proofs, together with a Poseidon-based hash-to-prime. The four upper rows prove the same integer Mod-R1CS statement of $6209$ modular-multiplication rows and were measured on the same machine (Apple M4, 16GB), single-threaded, as medians of five runs; prover time covers commitment and proving and excludes witness generation. The two lower rows are circuit-based baselines ($25.2$M and $6.2$M R1CS constraints respectively), for which we quote \cite  [Table 1]{limber} verbatim. {$\mathbb  {B}\text  {it}\mathbb  {Z}$}\ and Limber sample their fingerprinting prime from the transcript after the commitment and reach round-by-round Fiat--Shamir soundness errors of at most $2^{-114}$. $^{\ast }$ Zinc+ is benchmarked on the unwired mock circuit of \cite  [Table 1, footnote c]{limber}, extended to $8192$ slots: it omits the bit-decomposition and hash-to-prime rows and the range checks on the quotient advice, and uses a fixed rather than a transcript-sampled projecting prime, with $100$ column openings. Its proof compresses to $686$KB with \texttt  {zstd}; the other proofs are reported uncompressed. $^{\dagger }$ Quoted from \cite  {limber}; measured on an M4 Pro, 24GB, and not reproduced here. }}{53}{table.caption.53}\protected@file@percent }
\newlabel{t:multiswap}{{6}{53}{Proving one MultiSwap \cite {multiswap} batch update: two RSA-2048 accumulator updates verified through Wesolowski proofs, together with a Poseidon-based hash-to-prime. The four upper rows prove the same integer Mod-R1CS statement of $6209$ modular-multiplication rows and were measured on the same machine (Apple M4, 16GB), single-threaded, as medians of five runs; prover time covers commitment and proving and excludes witness generation. The two lower rows are circuit-based baselines ($25.2$M and $6.2$M R1CS constraints respectively), for which we quote \cite [Table 1]{limber} verbatim. \ftwoz \ and Limber sample their fingerprinting prime from the transcript after the commitment and reach round-by-round Fiat--Shamir soundness errors of at most $2^{-114}$. $^{\ast }$ Zinc+ is benchmarked on the unwired mock circuit of \cite [Table 1, footnote c]{limber}, extended to $8192$ slots: it omits the bit-decomposition and hash-to-prime rows and the range checks on the quotient advice, and uses a fixed rather than a transcript-sampled projecting prime, with $100$ column openings. Its proof compresses to $686$KB with \texttt {zstd}; the other proofs are reported uncompressed. $^{\dagger }$ Quoted from \cite {limber}; measured on an M4 Pro, 24GB, and not reproduced here}{table.caption.53}{}}
\newlabel{t:multiswap@cref}{{[table][6][]6}{[1][52][]53}{}{}{}}
