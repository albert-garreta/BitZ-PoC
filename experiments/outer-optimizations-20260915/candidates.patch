+use super::ordinary::R1csProductTableBuffers;
+/// Private prototype: storage is owned by the caller, never shared globally.
+pub(super) struct OuterScratch<E> {
+    pub large: Option<R1csProductTableBuffers<E>>,
+    pub small: Option<R1csProductTableBuffers<E>>,
+    pub equality: [Vec<E>; 2],
+}
+impl<E> Default for OuterScratch<E> {
+    fn default() -> Self { Self { large: None, small: None, equality: [Vec::new(), Vec::new()] } }
+}
+impl<E: Copy> OuterScratch<E> {
+    pub fn take(slot: &mut Option<R1csProductTableBuffers<E>>, len: usize, zero: E) -> R1csProductTableBuffers<E> {
+        let mut out = slot.take().unwrap_or_else(|| R1csProductTableBuffers::filled(0, &zero));
+        out.az.resize(len, zero); out.bz.resize(len, zero); out.cz.resize(len, zero);
+        out
+    }
+    pub fn bytes(&self) -> usize {
+        let tables = [&self.large, &self.small].into_iter().flatten().map(|p| p.az.capacity()+p.bz.capacity()+p.cz.capacity()).sum::<usize>();
+        (tables + self.equality.iter().map(Vec::capacity).sum::<usize>()) * std::mem::size_of::<E>()
+    }
+}
