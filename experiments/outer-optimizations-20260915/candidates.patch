+//! Isolated benchmark support. Removed from normal builds by `bench-internals`.
+use super::*;
+use crate::{piop::spartan::SpartanField, sumcheck::{UngrindedRoundBoundary, arithmetic::SumcheckProductReducer}, transcript::Blake3Transcript};
+use field::{Fp, FpCtx, Uint, RingOps, FieldOps, IntegerEmbedding, WideMul, Reduce, FoldPairs, BatchMulAcc};
+use rand::{RngExt, SeedableRng, rngs::StdRng};
+use std::{hint::black_box, sync::atomic::Ordering, time::Instant};
+
+#[derive(Clone, Copy)]
+struct Candidate { flags: usize, cutoff: usize, chunk: usize, two: usize }
+fn candidate(name: &str) -> Candidate {
+    let mut c = Candidate { flags: 0, cutoff: 4096, chunk: 0, two: 8 };
+    for part in name.split('+') {
+        match part {
+            "baseline" => (), "fuse" => c.flags |= 1, "first-par" => c.flags |= 2,
+            "prefix-msg" => c.flags |= 4, "prefix-fold" => c.flags |= 8,
+            "prefix" => c.flags |= 12, "scratch" => c.flags |= 16, "register-fuse" => c.flags |= 33,
+            s if s.starts_with("cutoff-") => c.cutoff = s[7..].parse().unwrap(),
+            s if s.starts_with("chunk-") => c.chunk = s[6..].parse().unwrap(),
+            s if s.starts_with("two-") => c.two = s[4..].parse().unwrap(),
+            _ => panic!("unknown candidate {part}"),
+        }
+    }
+    c
+}
+fn configure(c: Candidate) {
+    tuning::FLAGS.store(c.flags, Ordering::Relaxed);
+    tuning::CUTOFF.store(c.cutoff, Ordering::Relaxed);
+    tuning::CHUNK.store(c.chunk, Ordering::Relaxed);
+    tuning::TWO_LEVEL.store(c.two, Ordering::Relaxed);
+}
+fn words(name: &str, default: &str) -> Vec<String> {
+    std::env::var(name).unwrap_or_else(|_| default.into()).split_whitespace().map(str::to_owned).collect()
+}
+
+// A single driver monomorphizes exactly the same field provider with each
+// native input representation. No benchmark trait is added to the library API.
+fn bench_inputs<A, C>(kind: &str, field: &FpCtx<2>, a: &[A], b: &[A], c: &[C], variants: &[String], protocols: &[String], reps: usize, metrics: fn(bool) -> [usize;3])
+where
+    A: Copy + Send + Sync, C: Copy + Send + Sync,
+    FpCtx<2>: WideMul<Fp<2>,A> + WideMul<Fp<2>,C>
+        + FoldPairs<A,Fp<2>> + FoldPairs<C,Fp<2>>
+        + BatchMulAcc<Fp<2>,A> + BatchMulAcc<Fp<2>,C>
+        + Reduce<<FpCtx<2> as WideMul<Fp<2>,A>>::Product,Output=Fp<2>>
+        + Reduce<<FpCtx<2> as WideMul<Fp<2>,C>>::Product,Output=Fp<2>>
+        + Reduce<<FpCtx<2> as BatchMulAcc<Fp<2>,A>>::Accumulator,Output=Fp<2>>
+        + Reduce<<FpCtx<2> as BatchMulAcc<Fp<2>,C>>::Accumulator,Output=Fp<2>>,
+{
+    let n = a.len().ilog2() as usize;
+    let tau: Vec<_> = (0..n).map(|i| field.from_integer(&(i as u64 + 7))).collect();
+    for protocol in protocols {
+        let k: usize = protocol.strip_prefix("skip-").map_or(0, |s| s.parse().unwrap());
+        if n < k { continue; }
+        let prepared = (k > 0).then(|| prepare_univariate_skip(field,k as u8).unwrap());
+        let invoke = |scratch: &mut super::scratch::OuterScratch<Fp<2>>| {
+            let mut transcript = Blake3Transcript::new();
+            let before = metrics(true);
+            let start = Instant::now();
+            if std::env::var_os("OUTER_TRACE").is_some() { EPOCH.with(|e|e.set(Some(start)));SPANS.with(|s|s.borrow_mut().clear()); }
+            let reuse = tuning::enabled(16);
+            let (out, prefix): (OuterOutput<Fp<2>>, Option<UnivariateSkipProof<Fp<2>>>) = if let Some(prepared) = &prepared {
+                let (prefix, _z, claim, products, low, high) = univariate_api::prepare_prefix(
+                    field, &mut transcript, prepared, &tau[k..], a,b,c,&mut UngrindedRoundBoundary,
+                    reuse.then_some(&mut *scratch)).unwrap();
+                let factors = ordinary::EqualityFactors::with_workspace(low,high,field,reuse.then_some(&mut *scratch));
+                let state = engine::RoundState::new(claim,n-k,field);
+                let out = ordinary::continue_field(&mut transcript,field,field,&tau[k..],factors,products,state,None,
+                    &mut UngrindedRoundBoundary,reuse.then_some(&mut *scratch)).unwrap().into();
+                (out, Some(prefix))
+            } else {
+                let (state,factors,products,pending) = api::prepare_first(field,&mut transcript,field.zero(),&tau,a,b,c,
+                    protocol != "ordinary",&mut UngrindedRoundBoundary,reuse.then_some(&mut *scratch)).unwrap();
+                let out = ordinary::continue_field(&mut transcript,field,field,&tau,factors,products,state,pending,
+                    &mut UngrindedRoundBoundary,reuse.then_some(&mut *scratch)).unwrap().into();
+                (out,None)
+            };
+            let nanos = start.elapsed().as_nanos();
+            let after = metrics(false);
+            let allocation_count = after[0].saturating_sub(before[0]);
+            let peak_delta = after[2].saturating_sub(before[1]);
+            let digest = transcript.state_digest();
+            let mut verifier = Blake3Transcript::new();
+            if let Some(prefix) = &prefix {
+                verify_outer_zerocheck_with_skip(field,&mut verifier,prepared.as_ref().unwrap(),&tau[k..],prefix,&out.proof,out.evaluations,&mut UngrindedRoundBoundary).unwrap();
+            } else {
+                verify_outer_sumcheck(field,&mut verifier,field.zero(),&tau,&out.proof,out.evaluations,&mut UngrindedRoundBoundary).unwrap();
+            }
+            assert_eq!(digest,verifier.state_digest());
+            (nanos, out, prefix, digest, allocation_count, peak_delta)
+        };
+        configure(candidate("baseline"));
+        let (_, reference, prefix, digest, _, _) = invoke(&mut super::scratch::OuterScratch::default());
+        let mut workspaces: Vec<_> = variants.iter().map(|_| super::scratch::OuterScratch::default()).collect();
+        // One excluded warmup per candidate. Rotate the measured ordering.
+        for sample in 0..=reps {
+            for j in 0..variants.len() {
+                let name = &variants[(j+sample)%variants.len()];
+                configure(candidate(name));
+                let workspace = &mut workspaces[(j+sample)%variants.len()];
+                let (ns, out, p, d, allocs, peak) = invoke(workspace);
+                assert_eq!(out,reference,"{kind}/{protocol}/{name}");
+                assert_eq!(p,prefix);
+                assert_eq!(d,digest);
+                black_box(&out);
+                println!("OUTER_SAMPLE {}",serde_json::json!({"candidate":name,"input":kind,"protocol":protocol,"rows":a.len(),"threads":rayon::current_num_threads(),"sample":sample,"warmup":sample==0,"ns":ns.to_string(),"verified":true,"retained_bytes":workspace.bytes(),"allocations":allocs,"peak_delta_bytes":peak,"spans":SPANS.with(|s|s.borrow().clone())}));
+            }
+        }
+    }
+}
+
+pub fn run(metrics: fn(bool) -> [usize;3]) {
+    if std::env::var_os("OUTER_CHECK_WORKSPACE").is_some() { configure(candidate("fuse+first-par+prefix+scratch"));check_workspace();println!("workspace checks passed");return; }
+    let variants = words("OUTER_VARIANTS","baseline fuse first-par fuse+first-par prefix-msg prefix-fold prefix");
+    let protocols = words("OUTER_PROTOCOLS","ordinary zero skip-1 skip-2 skip-3 skip-4");
+    let types = words("OUTER_INPUTS","u32 u64 u128 field");
+    let reps = std::env::var("OUTER_REPS").map_or(5,|v| v.parse().unwrap());
+    let field = Fp::<2>::make_cfg(&Uint::from((1u128<<100)-15)).unwrap();
+    for exponent in words("OUTER_SHAPES","12 15 17 19") {
+        let n: usize = exponent.parse().unwrap();
+        let mut rng = StdRng::seed_from_u64(0x5533_326d_756c_0073 ^ n as u64);
+        let a: Vec<u128> = (0..1usize<<n).map(|_| rng.random()).collect();
+        let b: Vec<u128> = (0..a.len()).map(|_| rng.random()).collect();
+        for kind in &types {
+            match kind.as_str() {
+                "u32" => {
+                    let a:Vec<_>=a.iter().map(|v|*v as u32).collect(); let b:Vec<_>=b.iter().map(|v|*v as u32).collect();
+                    let c:Vec<_>=a.iter().zip(&b).map(|(a,b)|*a as u64 * *b as u64).collect();
+                    bench_inputs(kind,&field,&a,&b,&c,&variants,&protocols,reps,metrics);
+                }
+                "u64" => {
+                    let a:Vec<_>=a.iter().map(|v|*v as u64).collect(); let b:Vec<_>=b.iter().map(|v|*v as u64).collect();
+                    let c:Vec<_>=a.iter().zip(&b).map(|(a,b)|*a as u128 * *b as u128).collect();
+                    bench_inputs(kind,&field,&a,&b,&c,&variants,&protocols,reps,metrics);
+                }
+                "u128" => {
+                    let c:Vec<Uint<4>>=a.iter().zip(&b).map(|(a,b)| *field::IntegerOps.mul_wide(&Uint::<2>::from(*a),&Uint::<2>::from(*b)).checked_resize_ct::<4>().value()).collect();
+                    bench_inputs(kind,&field,&a,&b,&c,&variants,&protocols,reps,metrics);
+                }
+                "field" => {
+                    let a:Vec<_>=a.iter().map(|v|field.from_integer(v)).collect(); let b:Vec<_>=b.iter().map(|v|field.from_integer(v)).collect();
+                    let c:Vec<_>=a.iter().zip(&b).map(|(a,b)|field.mul(a,b)).collect();
+                    bench_inputs(kind,&field,&a,&b,&c,&variants,&protocols,reps,metrics);
+                }
+                _ => panic!("unknown input {kind}"),
+            }
+        }
+    }
+}
+
+thread_local! {
+    static EPOCH: std::cell::Cell<Option<Instant>> = const { std::cell::Cell::new(None) };
+    static SPANS: std::cell::RefCell<Vec<(&'static str,u128,u128)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+pub(super) fn stamp() -> Option<Instant> { EPOCH.with(|e|e.get().map(|_|Instant::now())) }
+pub(super) fn record(name:&'static str,start:Option<Instant>) {
+    if let Some(start)=start { let end=Instant::now(); EPOCH.with(|epoch| { let epoch=epoch.get().unwrap();SPANS.with(|v|v.borrow_mut().push((name,start.duration_since(epoch).as_nanos(),end.duration_since(epoch).as_nanos()))); }); }
+}
+// Invoked by the private experimental harness, not a public API.
+fn check_workspace() {
+    let check = || {
+        let mut scratch = super::scratch::OuterScratch::default();
+        for modulus in [(1u128 << 100)-15, 97] {
+            let field = Fp::<2>::make_cfg(&Uint::from(modulus)).unwrap();
+            for n in [0,1,4,14,5,0,14] {
+                let a:Vec<u64>=(0..1usize<<n).map(|i|i as u64+3).collect();
+                let b:Vec<u64>=a.iter().map(|a|a+7).collect();
+                let c:Vec<u128>=a.iter().zip(&b).map(|(a,b)|*a as u128 * *b as u128).collect();
+                let tau:Vec<_>=(0..n).map(|i|field.from_integer(&(i as u64+7))).collect();
+                let mut t=Blake3Transcript::new();
+                let reference=prove_outer_zerocheck_from_slices(&field,&mut t,&tau,&a,&b,&c,&mut UngrindedRoundBoundary).unwrap();
+                let digest=t.state_digest();
+                let mut t=Blake3Transcript::new();
+                let(state,factors,products,pending)=api::prepare_first(&field,&mut t,field.zero(),&tau,&a,&b,&c,true,&mut UngrindedRoundBoundary,Some(&mut scratch)).unwrap();
+                let got:OuterOutput<_>=ordinary::continue_field(&mut t,&field,&field,&tau,factors,products,state,pending,&mut UngrindedRoundBoundary,Some(&mut scratch)).unwrap().into();
+                assert_eq!(got,reference);assert_eq!(digest,t.state_digest());
+                assert!(api::prepare_first(&field,&mut Blake3Transcript::new(),field.zero(),&tau,&a,&[],&c,true,&mut UngrindedRoundBoundary,Some(&mut scratch)).is_err());
+            }
+        }
+    };
+    // Each concurrent proof owns its buffers. Only immutable field data and
+    // benchmark policy are shared; the failed call must not poison reuse.
+    rayon::join(check,check);
+}
