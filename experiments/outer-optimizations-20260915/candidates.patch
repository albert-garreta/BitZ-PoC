+//! Controls for the isolated outer-kernel experiments.
+#[cfg(feature = "bench-internals")]
+use std::sync::atomic::{AtomicUsize, Ordering};
+#[cfg(feature = "bench-internals")]
+pub(super) static FLAGS: AtomicUsize = AtomicUsize::new(0);
+#[cfg(feature = "bench-internals")]
+pub(super) static CUTOFF: AtomicUsize = AtomicUsize::new(4096);
+#[cfg(feature = "bench-internals")]
+pub(super) static CHUNK: AtomicUsize = AtomicUsize::new(0);
+#[cfg(feature = "bench-internals")]
+pub(super) static TWO_LEVEL: AtomicUsize = AtomicUsize::new(8);
+#[inline]
+pub(super) fn enabled(bit: usize) -> bool {
+    #[cfg(feature = "bench-internals")]
+    { return FLAGS.load(Ordering::Relaxed) & bit != 0; }
+    #[cfg(not(feature = "bench-internals"))]
+    { let _ = bit; false }
+}
+#[inline]
+pub(super) fn cutoff() -> usize {
+    #[cfg(feature = "bench-internals")]
+    { return CUTOFF.load(Ordering::Relaxed); }
+    #[cfg(not(feature = "bench-internals"))]
+    { 4096 }
+}
+#[inline]
+pub(super) fn chunk() -> usize {
+    #[cfg(feature = "bench-internals")]
+    { return CHUNK.load(Ordering::Relaxed); }
+    #[cfg(not(feature = "bench-internals"))]
+    { 0 }
+}
+#[inline]
+pub(super) fn two_level() -> usize {
+    #[cfg(feature = "bench-internals")]
+    { return TWO_LEVEL.load(Ordering::Relaxed); }
+    #[cfg(not(feature = "bench-internals"))]
+    { 8 }
